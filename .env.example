# Chain. Base Sepolia by default.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_POAP_ADDRESS=0xC3249356a483fbe17d5355D39105D2eA666d9de6

# RPC endpoint. The public default is rate limited, so use your own provider.
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# WalletConnect project ID from dashboard.reown.com. Without one, a shared
# development ID is used and browser-injected wallets still connect.
NEXT_PUBLIC_WC_PROJECT_ID=

# Canonical URL. Used for share embeds and the Mini App manifest.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Farcaster Miniapp account association. These are PUBLIC manifest values,
# bound to the exact NEXT_PUBLIC_APP_URL origin, and must be generated for the
# final production domain with Farcaster developer tooling. Never place a
# private key or signing secret in a NEXT_PUBLIC_* variable.
FARCASTER_ACCOUNT_ASSOCIATION_HEADER=
FARCASTER_ACCOUNT_ASSOCIATION_PAYLOAD=
FARCASTER_ACCOUNT_ASSOCIATION_SIGNATURE=
